#!/usr/bin/env qore
# Copyright (C) 2026 David Nichols
# SPDX-License-Identifier: MIT

%modern
%prepend-module-path "${SCRIPT_DIR}/../build"
%requires QUnit
%requires freetds
%exec-class FreeTdsOfflineTest

#! Validate the driver without opening a network connection.
class FreeTdsOfflineTest inherits QUnit::Test {
    public {
        #! the execution modes that a NULL protocol is set in
        const Modes = {"ast": EM_AST, "ir": EM_IR, "jit": EM_JIT, "tiered": EM_TIERED};

        #! the outcome of opening a connection with a NULL protocol
        const NullProtocolError = "TDS-OPTION-ERROR: invalid value '' for the 'tds-version' option; expecting one "
            "of: \"auto\", \"4.0\", \"4.2\", \"4.6\", \"4.9.5\", \"5.0\", \"7.0\", \"7.1\", \"7.2\", \"7.3\", "
            "\"7.4\"";

        #! sets a NULL protocol and opens the connection; each function returns the exception as "err: desc"
        /** The AST interpreter and the IR and JIT engines pass a literal NULL to a builtin differently, so the
            option is set from code parsed in each execution mode: from a function and a method, with a literal
            NULL and NULL from a variable
        */
        const NullProtocolCode = "%modern
string sub open_with(auto val) {
    Datasource db(\"freetds:offline@unused\");
    try {
        db.setOption(\"tds-version\", val);
        db.open();
        db.close();
        return \"opened\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
string sub literal_null() {
    Datasource db(\"freetds:offline@unused\");
    try {
        db.setOption(\"tds-version\", NULL);
        db.open();
        db.close();
        return \"opened\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
string sub variable_null() {
    auto n = NULL;
    return open_with(n);
}
class NullProtocol {
    string literalNull() {
        Datasource db(\"freetds:offline@unused\");
        try {
            db.setOption(\"tds-version\", NULL);
            db.open();
            db.close();
            return \"opened\";
        } catch (hash<ExceptionInfo> ex) {
            return ex.err + \": \" + ex.desc;
        }
    }
}
string sub method_literal_null() {
    return (new NullProtocol()).literalNull();
}
";
    }

    constructor() : Test("FreeTdsOfflineTest", "1.0", \ARGV) {
        addTestCase("driver capabilities", \capabilities());
        addTestCase("protocol validation before connection", \invalidProtocol());
        addTestCase("a NULL protocol before connection in each execution mode", \nullProtocol());
        addTestCase("missing username before connection", \missingUsername());
        addTestCase("unopened connection cleanup", \cleanup());
        set_return_value(main());
    }

    capabilities() {
        Datasource db("freetds:offline@unused");
        assertEq("freetds", db.getDriverName());
        int caps = db.getCapabilities();
        foreach int cap in (DBI_CAP_TRANSACTION_MANAGEMENT, DBI_CAP_BIND_BY_VALUE,
                DBI_CAP_BIND_BY_PLACEHOLDER, DBI_CAP_LOB_SUPPORT,
                DBI_CAP_HAS_BULK_LOAD, DBI_CAP_HAS_COLUMNAR_SELECT, DBI_CAP_HAS_EXECRAW) {
            assertTrue((caps & cap) != 0);
        }
    }

    invalidProtocol() {
        Datasource db("freetds:offline@unused{tds-version=bogus}");
        assertThrows("TDS-OPTION-ERROR", sub () { db.open(); });
        assertFalse(db.inTransaction());
        db.close();
    }

    nullProtocol() {
        foreach hash<auto> mode in (Modes.pairIterator()) {
            Program pgm();
            pgm.setExecMode(mode.value);
            pgm.parse(NullProtocolCode, "null-protocol-" + mode.key);
            foreach string func in ("literal_null", "variable_null", "method_literal_null") {
                assertEq(NullProtocolError, pgm.callFunction(func), mode.key + " " + func);
            }
        }
    }

    missingUsername() {
        Datasource db("freetds:@unused");
        assertThrows("DATASOURCE-MISSING-USERNAME", sub () { db.open(); });
        assertFalse(db.inTransaction());
    }

    cleanup() {
        Datasource db("freetds:offline@unused");
        assertFalse(db.inTransaction());
        db.close();
        db.close();
        assertFalse(db.inTransaction());
    }
}
